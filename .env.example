# =================================
# FitCloud Environment Variables
# =================================
# Copy this file to .env and fill in your values

# =================================
# AWS Configuration
# =================================
AWS_REGION=us-east-1
AWS_PROFILE=fitcloud

# =================================
# Cognito Configuration
# =================================
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# =================================
# API Configuration
# =================================
VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod

# =================================
# External APIs
# =================================
# WGER Exercise API (Free, no key required)
WGER_API_URL=https://wger.de/api/v2

# Nutritionix API (Get free key at nutritionix.com)
NUTRITIONIX_APP_ID=xxxxxxxx
NUTRITIONIX_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =================================
# AWS Bedrock (AI Features)
# =================================
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# =================================
# DynamoDB Table Names
# =================================
USERS_TABLE_NAME=fitcloud-users
WORKOUTS_TABLE_NAME=fitcloud-workouts
NUTRITION_TABLE_NAME=fitcloud-nutrition
PLANS_TABLE_NAME=fitcloud-plans
ANALYTICS_TABLE_NAME=fitcloud-analytics

# =================================
# S3 Buckets
# =================================
AVATARS_BUCKET_NAME=fitcloud-avatars-xxxxxxxxx
EXPORTS_BUCKET_NAME=fitcloud-exports-xxxxxxxxx

# =================================
# Monitoring
# =================================
ALERT_EMAIL=your-email@example.com

# =================================
# Development Settings
# =================================
NODE_ENV=development
LOG_LEVEL=debug

# =================================
# Testing
# =================================
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=TestPassword123!
